{
  "name": "advisor-pulse-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . && node --test tests/colors.test.mjs && node scripts/check-colors.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "types": "node scripts/generate-types.mjs",
    "types:check": "node scripts/generate-types.mjs --check"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "30.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.4.1",
    "vitest": "4.1.11"
  }
}
