{
  "$defs": {
    "ExportFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "name": {
          "description": "Path relative to the data/ directory.",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "rows": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null for JSON documents.",
          "title": "Rows"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256",
        "bytes"
      ],
      "title": "ExportFile",
      "type": "object"
    },
    "KpiCode": {
      "description": "KPI codes from PLAN.md \u00a77.",
      "enum": [
        "ACT_PER_ADV",
        "CALLS_OUT",
        "APPT_BOOKED",
        "CALL_TO_APPT",
        "SHOW_RATE",
        "APPT_CONV",
        "CLIENTS_CONTACTED",
        "COVERAGE_13W",
        "AVG_MEET_MIN",
        "NO_SHOW_RATE",
        "LATE_RATE",
        "QUAR_RATE"
      ],
      "title": "KpiCode",
      "type": "string"
    },
    "ReportFlag": {
      "enum": [
        "UP",
        "DOWN",
        "FLAT",
        "ANOMALY"
      ],
      "title": "ReportFlag",
      "type": "string"
    },
    "SummaryKpi": {
      "additionalProperties": false,
      "properties": {
        "flag": {
          "$ref": "#/$defs/ReportFlag"
        },
        "kpi_code": {
          "$ref": "#/$defs/KpiCode"
        },
        "prior_week_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prior Week Value"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "wow_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wow Pct"
        }
      },
      "required": [
        "kpi_code",
        "flag"
      ],
      "title": "SummaryKpi",
      "type": "object"
    }
  },
  "$id": "https://pulse.charliebuild.com/contracts/manifest.schema.json",
  "additionalProperties": false,
  "description": "data/manifest.json: what the latest successful run exported, plus a national KPI summary so the overview can paint before DuckDB-WASM loads.",
  "properties": {
    "files": {
      "items": {
        "$ref": "#/$defs/ExportFile"
      },
      "title": "Files",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "has_fsa_boundaries": {
      "default": false,
      "description": "True when geo/fsa.topo.json shipped (optional layer).",
      "title": "Has Fsa Boundaries",
      "type": "boolean"
    },
    "latest_week": {
      "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$",
      "title": "Latest Week",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "description": "National KPIs for latest_week.",
      "items": {
        "$ref": "#/$defs/SummaryKpi"
      },
      "title": "Summary",
      "type": "array"
    },
    "weeks_available": {
      "items": {
        "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Weeks Available",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "generated_at",
    "latest_week",
    "weeks_available",
    "files",
    "summary"
  ],
  "title": "manifest",
  "type": "object",
  "x-contract-kind": "document",
  "x-schema-version": "1.0.0"
}
