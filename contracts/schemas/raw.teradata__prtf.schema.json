{
  "$id": "https://pulse.charliebuild.com/contracts/raw.teradata__prtf.schema.json",
  "additionalProperties": false,
  "description": "Raw portfolio master.",
  "properties": {
    "BRNCH_ID": {
      "description": "Transit: the owning branch.",
      "pattern": "^BR-\\d{4}$",
      "title": "Brnch Id",
      "type": "string"
    },
    "CLOSE_DT": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Close Dt"
    },
    "LAST_UPD_TS": {
      "description": "Watermark column.",
      "format": "date-time",
      "title": "Last Upd Ts",
      "type": "string"
    },
    "OPEN_DT": {
      "format": "date",
      "title": "Open Dt",
      "type": "string"
    },
    "PRTF_ID": {
      "pattern": "^PRT-\\d{6}$",
      "title": "Prtf Id",
      "type": "string"
    },
    "_batch_id": {
      "description": "run_id + source + file hash prefix.",
      "minLength": 1,
      "title": "Batch Id",
      "type": "string"
    },
    "_loaded_at": {
      "format": "date-time",
      "title": "Loaded At",
      "type": "string"
    },
    "_row_hash": {
      "description": "xxhash of business columns.",
      "minLength": 1,
      "title": "Row Hash",
      "type": "string"
    },
    "_source_file": {
      "description": "Relative path.",
      "minLength": 1,
      "title": "Source File",
      "type": "string"
    },
    "_source_row": {
      "description": "Row number in the file.",
      "minimum": 0,
      "title": "Source Row",
      "type": "integer"
    }
  },
  "required": [
    "PRTF_ID",
    "BRNCH_ID",
    "OPEN_DT",
    "LAST_UPD_TS",
    "_batch_id",
    "_source_file",
    "_source_row",
    "_row_hash",
    "_loaded_at"
  ],
  "title": "raw.teradata__prtf",
  "type": "object",
  "x-contract-kind": "table",
  "x-schema-version": "1.0.0"
}
