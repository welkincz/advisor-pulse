      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "source_file": {
      "minLength": 1,
      "title": "Source File",
      "type": "string"
    },
    "source_row": {
      "minimum": 0,
      "title": "Source Row",
      "type": "integer"
    },
    "table_name": {
      "minLength": 1,
      "title": "Table Name",
      "type": "string"
    }
  },
  "required": [
    "rejected_id",
    "run_id",
    "batch_id",
    "source",
    "table_name",
    "source_file",
    "source_row",
    "rule_id",
