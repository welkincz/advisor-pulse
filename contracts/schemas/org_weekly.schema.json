{
  "$defs": {
    "OrgLevel": {
      "enum": [
        "NATIONAL",
        "REGION",
        "DISTRICT",
        "BRANCH"
      ],
      "title": "OrgLevel",
      "type": "string"
    }
  },
  "$id": "https://pulse.charliebuild.com/contracts/org_weekly.schema.json",
  "additionalProperties": false,
  "description": "mart_org_weekly: one row per hierarchy node and ISO week, every level. Ratios are recomputed from summed parts, never averaged.",
  "properties": {
    "active_advisors": {
      "minimum": 0,
      "title": "Active Advisors",
      "type": "integer"
    },
    "activities_completed": {
      "minimum": 0,
      "title": "Activities Completed",
      "type": "integer"
    },
    "activities_per_advisor": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activities Per Advisor"
    },
    "appointments_booked": {
      "minimum": 0,
      "title": "Appointments Booked",
      "type": "integer"
    },
    "appointments_held": {
      "minimum": 0,
      "title": "Appointments Held",
      "type": "integer"
    },
    "avg_meeting_duration_min": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Avg Meeting Duration Min"
    },
    "book_size": {
      "minimum": 0,
      "title": "Book Size",
      "type": "integer"
    },
    "call_to_appt_rate": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call To Appt Rate"
    },
    "calls_in": {
      "minimum": 0,
      "title": "Calls In",
      "type": "integer"
    },
    "calls_out": {
      "minimum": 0,
      "title": "Calls Out",
      "type": "integer"
    },
    "clients_covered_13w": {
      "minimum": 0,
      "title": "Clients Covered 13W",
      "type": "integer"
    },
    "conversion_rate": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversion Rate"
    },
    "conversions": {
      "minimum": 0,
      "title": "Conversions",
      "type": "integer"
    },
    "coverage_rate_13w": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage Rate 13W"
    },
    "iso_week_id": {
      "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$",
      "title": "Iso Week Id",
      "type": "string"
    },
    "level": {
      "$ref": "#/$defs/OrgLevel"
    },
    "no_shows": {
      "minimum": 0,
      "title": "No Shows",
      "type": "integer"
    },
    "node_id": {
      "description": "'CA' for national; region, district or branch code.",
      "minLength": 1,
      "title": "Node Id",
      "type": "string"
    },
    "node_name": {
      "minLength": 1,
      "title": "Node Name",
      "type": "string"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Null for the national node.",
      "title": "Parent Id"
    },
    "portfolio_clients": {
      "description": "PRTF_CONTACT_12M denominator.",
      "minimum": 0,
      "title": "Portfolio Clients",
      "type": "integer"
    },
    "portfolio_contacted_12m": {
      "description": "PRTF_CONTACT_12M numerator.",
      "minimum": 0,
      "title": "Portfolio Contacted 12M",
      "type": "integer"
    },
    "portfolio_contacted_rate_12m": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The lead KPI; null before 12 months of history.",
      "title": "Portfolio Contacted Rate 12M"
    },
    "show_rate": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Show Rate"
    },
    "unique_clients_contacted": {
      "minimum": 0,
      "title": "Unique Clients Contacted",
      "type": "integer"
    }
  },
  "required": [
    "iso_week_id",
    "level",
    "node_id",
    "node_name",
    "active_advisors",
    "activities_completed",
    "calls_out",
    "calls_in",
    "appointments_booked",
    "appointments_held",
    "no_shows",
    "conversions",
    "unique_clients_contacted",
    "book_size",
    "clients_covered_13w",
    "portfolio_clients",
    "portfolio_contacted_12m"
  ],
  "title": "org_weekly",
  "type": "object",
  "x-contract-kind": "table",
  "x-schema-version": "1.0.0"
}
