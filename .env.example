# Copy to .env for local runs. Only PULSE_* are needed locally;
# everything else is optional, and code paths that need it skip cleanly when absent.

PULSE_DATA_DIR=data
PULSE_SEED=20261013
# Empty: the backend default (api: claude-opus-5-5, claude-code: claude-sonnet-5-5).
PULSE_NARRATIVE_MODEL=

# AI narrative (issues #47, #113)
# api: Anthropic API, billed to ANTHROPIC_API_KEY.
# claude-code: the claude CLI on a Claude subscription (logged-in account locally;
# CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token` in CI). Defaults the model to claude-sonnet-5-5.
PULSE_NARRATIVE_BACKEND=api
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# State on Cloudflare R2 (issue #45)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=advisor-pulse-state
R2_ENDPOINT_URL=

# Google Sheets feed for Tableau Public (issue #55)
GOOGLE_SERVICE_ACCOUNT_JSON=
GSHEET_ID=

# Optional alert webhook (issue #50)
ALERT_WEBHOOK_URL=
